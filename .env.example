# Copy to .env for local development. Never commit .env.
# Generate independent random secrets; placeholders are rejected in production.

ATTENDANCE_APP_ENV=development
ATTENDANCE_DEBUG=false
ATTENDANCE_DATABASE_URL=sqlite:///./backend/data/attendance.db
ATTENDANCE_TIMEZONE=Asia/Tashkent
ATTENDANCE_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
ATTENDANCE_PUBLIC_BASE_URL=http://127.0.0.1:8000
ATTENDANCE_SESSION_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
ATTENDANCE_SESSION_COOKIE_NAME=school_attendance_session
ATTENDANCE_SESSION_COOKIE_SECURE=false
ATTENDANCE_SESSION_COOKIE_SAME_SITE=lax
ATTENDANCE_SESSION_MAX_AGE_SECONDS=28800
ATTENDANCE_CSRF_TOKEN_BYTES=32
ATTENDANCE_PASSWORD_MIN_LENGTH=12
ATTENDANCE_PASSWORD_MAX_LENGTH=256
ATTENDANCE_API_INGEST_ENABLED=false
ATTENDANCE_API_INGEST_KEY=replace-with-an-independent-random-value-of-at-least-32-characters
ATTENDANCE_RECOGNITION_MIN_SIMILARITY=0.60
ATTENDANCE_RECOGNITION_COOLDOWN_SECONDS=30
ATTENDANCE_RECOGNITION_MAX_EVENT_AGE_SECONDS=300
ATTENDANCE_ALLOW_LEGACY_NAME_FALLBACK=false
ATTENDANCE_ATTENDANCE_ON_TIME_HOUR=8
ATTENDANCE_ATTENDANCE_ON_TIME_MINUTE=30
ATTENDANCE_ROSTER_MAX_BYTES=1000000
ATTENDANCE_ROSTER_MAX_ROWS=10000
ATTENDANCE_LOGIN_WINDOW_SECONDS=900
ATTENDANCE_LOGIN_MAX_ATTEMPTS=5
ATTENDANCE_AUTO_SEED_DEMO=false

RECOGNITION_APP_ENV=development
RECOGNITION_DATA_DIR=./recognition/data
RECOGNITION_MODELS_DIR=./recognition/models
RECOGNITION_MODEL_NAME=buffalo_l
RECOGNITION_PREFERRED_PROVIDERS=["CUDAExecutionProvider","CPUExecutionProvider"]
RECOGNITION_MATCH_THRESHOLD=0.45
RECOGNITION_DISPLAY_THRESHOLD=0.60
RECOGNITION_CONFIRM_THRESHOLD=0.68
RECOGNITION_API_MIN_SIMILARITY=0.60
RECOGNITION_DETECTION_SIZE=[640,640]
RECOGNITION_WEBCAM_DETECTION_SIZE=[320,320]
RECOGNITION_MIN_FACE_SIZE=40
RECOGNITION_CAMERA_ID=0
RECOGNITION_CAMERA_MODE=ENTRY
RECOGNITION_VIDEO_SOURCE=0
RECOGNITION_VIDEO_SOURCE_TYPE=auto
RECOGNITION_VIDEO_SOURCE_NAME=
RECOGNITION_WEBCAM_FRAME_WIDTH=960
RECOGNITION_WEBCAM_FRAME_HEIGHT=540
RECOGNITION_WEBCAM_PROCESS_EVERY_N_FRAMES=4
RECOGNITION_WEBCAM_RECOGNITION_SCALE=0.5
RECOGNITION_WEBCAM_RESULT_TTL_SECONDS=0.5
RECOGNITION_WEBCAM_MAX_QUEUE_SIZE=16
RECOGNITION_WEBCAM_ENABLE_THREADED_CAPTURE=true
RECOGNITION_WEBCAM_START_FULLSCREEN=false
RECOGNITION_WEBCAM_OVERLAY_MODE=minimal
RECOGNITION_MAX_ACTIVE_FACES=5
RECOGNITION_TRACK_MATCH_DISTANCE_THRESHOLD=100
RECOGNITION_TRACK_MAX_MISSING_FRAMES=10
RECOGNITION_TRACK_MAX_AGE_SECONDS=2.0
RECOGNITION_CAMERA_AUTO_RECONNECT=true
RECOGNITION_CAMERA_RECONNECT_INTERVAL_SECONDS=2.0
RECOGNITION_CAMERA_MAX_READ_FAILURES_BEFORE_RECONNECT=5
RECOGNITION_CAMERA_READ_FAILURE_RETRY_DELAY_SECONDS=0.1
RECOGNITION_TEMPORAL_SMOOTHING=true
RECOGNITION_SMOOTHING_WINDOW=5
RECOGNITION_REQUIRED_CONSECUTIVE_HITS=3
RECOGNITION_MAX_MISSES_BEFORE_RESET=2
RECOGNITION_STABILITY_TIME_WINDOW=2.0
RECOGNITION_RECOGNITION_POSITION_TOLERANCE=80
RECOGNITION_API_ENABLED=false
RECOGNITION_API_URL=http://127.0.0.1:8000/api/recognition-event
RECOGNITION_API_KEY=replace-with-the-backend-ingest-key
RECOGNITION_API_TIMEOUT_SECONDS=5
RECOGNITION_API_COOLDOWN_SECONDS=30
RECOGNITION_API_MAX_RETRIES=2
RECOGNITION_SNAPSHOT_ENABLED=false
RECOGNITION_SNAPSHOT_DIR=./recognition/data/snapshots
RECOGNITION_SNAPSHOT_JPEG_QUALITY=90
RECOGNITION_SNAPSHOT_FACE_PADDING=0.25
RECOGNITION_SNAPSHOT_COOLDOWN_SECONDS=60
RECOGNITION_FRAME_RESIZE_SCALE=1.0
RECOGNITION_FRAME_SKIP=0
RECOGNITION_LOG_LEVEL=INFO
RECOGNITION_QUIET_MODE=true
